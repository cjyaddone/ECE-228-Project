{
  "seed": 42,
  "matrix": "full",
  "max_epochs": 100,
  "patience": 20,
  "batch_size": 128,
  "optimizer": "AdamW",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "scheduler": "ReduceLROnPlateau(factor=0.5, patience=4)",
  "early_stopping_patience": 20,
  "triline_loss_weights": {
    "fly": 1.0,
    "distance": 1.0,
    "direction": 0.5
  },
  "distance_weighted_training": true,
  "distance_weight_scope": "triline ablation; distance loss plus optional direction loss",
  "distance_weight_configs": {
    "mild_bins": {
      "bins": [
        1.0,
        1.25,
        1.75,
        2.5
      ],
      "direction_weighted": true
    },
    "medium_bins": {
      "bins": [
        1.0,
        1.5,
        2.5,
        4.0
      ],
      "direction_weighted": true
    },
    "distance_only": {
      "bins": [
        1.0,
        1.5,
        2.5,
        4.0
      ],
      "direction_weighted": false
    },
    "current_bins": {
      "bins": [
        1.0,
        2.0,
        4.0,
        8.0
      ],
      "direction_weighted": true
    }
  },
  "movement_categories": [
    "stationary",
    "short",
    "medium",
    "large"
  ],
  "checkpoint_selection": {
    "mode": "balanced",
    "require_migration50_improvement": true,
    "max_mean_error_worsening_km": 0.5,
    "score": "gated_mean_error_km"
  },
  "rollout_threshold_offsets": [
    -0.1,
    -0.05,
    0.0,
    0.05,
    0.1
  ],
  "baseline_comparison_dir": "D:\\UCSD\\ECE 228\\ECE-228-Project\\Path_Experiment_WithWeather",
  "v1_comparison_dir": "D:\\UCSD\\ECE 228\\ECE-228-Project\\DistanceWeightTune",
  "device": "cuda",
  "weather_data": true,
  "weather_match_policy": "exact bird/date, nearest same-bird date fallback",
  "weather_rollout_policy": "actual future daily weather as exogenous forecast/oracle input",
  "feature_columns": [
    "lat_median",
    "lon_median",
    "delta_lat",
    "delta_lon",
    "step_length_km",
    "heading_sin",
    "heading_cos",
    "doy_sin",
    "doy_cos",
    "stopover_duration_days",
    "temp_2m_celsius",
